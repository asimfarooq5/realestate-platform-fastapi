# Malkiyat Real Estate API — environment configuration
# Copy this file to .env and fill in real values.

# --- Security (REQUIRED) ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- Database ---
# Local dev (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./malkiyat.db
# Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://malkiyat_user:123456@localhost:5432/malkiyat

# --- App ---
PROJECT_NAME=Malkiyat Real Estate API
VERSION=1.0.0

# --- Security settings ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Login rate limiting: max attempts per window (seconds)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300

# --- CORS (JSON array of allowed origins) ---
# Flutter native app doesn't need CORS; add web admin origin here if you add one.
BACKEND_CORS_ORIGINS=["*"]
